{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check_freshness.py\" \"${CLAUDE_PROJECT_DIR:-.}\" --hook",
            "timeout": 30,
            "statusMessage": "Checking vault freshness"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/write_flow_register.py\" --hook",
            "timeout": 10,
            "statusMessage": "Checking write-flow register"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/detect_tier.py\"",
            "timeout": 10,
            "statusMessage": "Locating the augment vault"
          }
        ]
      }
    ]
  }
}
